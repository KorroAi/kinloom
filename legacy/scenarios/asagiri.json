  "quests": [
    {
      "giver": "mira",
      "kind": "accuse",
      "target": "riku",
      "reward": 10,
      "text": "Someone stole a sack of flour from my storeroom last week. Find out who — ask around.",
      "texts": {
        "fr": "Quelqu'un m'a volé un sac de farine dans ma réserve la semaine dernière. Découvre qui — renseigne-toi."
      }
    },
    {
      "giver": "goro",
      "kind": "retrieve_item",
      "target": "goro",
      "item": "ore",
      "reward": 5,
      "rewardItem": "katana",
      "text": "Bring me iron ore from the Spirit Grove in the forest. Spiders nest there. Do it, and the masterwork katana is yours.",
      "texts": {
        "fr": "Rapporte-moi du minerai de fer du Bosquet des Esprits, dans la forêt. Des araignées y nichent. Fais-le, et le katana de maître est à toi."
      }
    },
    {
      "giver": "sen",
      "kind": "retrieve_item",
      "target": "sen",
      "item": "moon_herb",
      "reward": 5,
      "rewardItem": "herbs",
      "text": "Bring me a Moon Herb from the Mushroom Glade, west of the river. Mind the slimes.",
      "texts": {
        "fr": "Rapporte-moi une Herbe de Lune de la Clairière aux Champignons, à l'ouest de la rivière. Méfie-toi des slimes."
      }
    },
    {
      "giver": "emi",
      "kind": "retrieve_item",
      "target": "emi",
      "item": "ledger",
      "reward": 12,
      "text": "Haru cheats on the rice tax, I know it. Get me Haru's ledger — however you must.",
      "texts": {
        "fr": "Haru triche sur l'impôt du riz, j'en mettrais ma main au feu. Rapporte-moi le registre de Haru — par n'importe quel moyen."
      }
    },
    {
      "giver": "kaito",
      "kind": "slay",
      "target": "boar",
      "reward": 10,
      "text": "Boar, one of Crow's bandits, beat me in the forest last month. Help me bring Boar down.",
      "texts": {
        "fr": "Boar, un des bandits de Crow, m'a mis à terre dans la forêt le mois dernier. Aide-moi à vaincre Boar."
      }
    },
    {
      "giver": "jun",
      "kind": "retrieve_item",
      "target": "jun",
      "item": "relic",
      "reward": 30,
      "day": 2,
      "hour": 6,
      "text": "The Jade Fox Relic is gone! Someone opened the shrine in the night. Bring it back before the festival.",
      "texts": {
        "fr": "Le Reliquaire du Renard de Jade a disparu ! Quelqu'un a ouvert le sanctuaire cette nuit. Rapporte-le avant la fête."
      }
    },
    {
      "giver": "ren",
      "kind": "accuse",
      "target": "riku",
      "reward": 15,
      "day": 2,
      "hour": 7,
      "text": "The relic was taken in the night. Find out who did it and tell me — and be sure of it.",
      "texts": {
        "fr": "La relique a été prise cette nuit. Découvre qui a fait ça et viens me le dire — sans te tromper."
