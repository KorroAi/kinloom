+extends Node
+# Check of the radio keys in the real menu flow (needs a window: the menu waits for a rendered frame).
+# T opens the radio, Esc closes it, and we must still be in town, unpaused.
+var step := 0
+var since := 0
+
+func key(code: Key) -> void:
+	for pressed in [true, false]:
+		var e := InputEventKey.new()
+		e.keycode = code
+		e.physical_keycode = code
+		e.pressed = pressed
+		Input.parse_input_event(e)
+
+func town() -> Node:
+	return $CarSelect.town if is_instance_valid($CarSelect.town) else null
+
+func _ready():
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	$CarSelect.process_mode = Node.PROCESS_MODE_PAUSABLE # as in the real game (main scene under the root)
+	$CarSelect._on_tow_truck_pressed.call_deferred()
+
+func wait(ms: int) -> bool:
+	return Time.get_ticks_msec() - since > ms
+
+func next():
+	step += 1
+	since = Time.get_ticks_msec()
+
+func _process(_delta):
+	match step:
+		0:
+			if town() != null and town().is_inside_tree(): next()
+		1:
+			if wait(2000):
+				key(KEY_T)
+				next()
+		2:
+			if wait(500):
+				print("KINLOOM_RADIO open=", town().radio_input.visible, " paused=", get_tree().paused)
+				key(KEY_ESCAPE)
+				next()
+		3:
+			if wait(1000):
+				var t := town()
+				var ok: bool = t != null and not t.radio_input.visible and not get_tree().paused and not $CarSelect.visible
+				print("KINLOOM_RADIO still_in_town=", t != null, " menu_visible=", $CarSelect.visible, " paused=", get_tree().paused)
+				print("KINLOOM_RADIO ", "PASS" if ok else "FAIL")
+				get_tree().quit(0 if ok else 1)
