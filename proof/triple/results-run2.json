 "remark": [
  {
   "about": "the player raised a lighthouse on the north shore",
   "who": "an old fisherman",
   "line": "Fourteen feet taller? That light'll scare the fish blind!",
   "source": "model",
   "words": 9
  },
  {
   "about": "a cart lost a wheel in front of the bakery",
   "who": "a baker",
   "line": "That cart lost a wheel right at my doorstep!",
   "source": "model",
   "words": 9
  },
  {
   "about": "the champion fell in the first round",
   "who": "a child in the crowd",
   "line": "First round and the champion's already down? Unbelievable!",
   "source": "model",
   "words": 8
  },
  {
   "about": "the bridge opened after nine days of work",
   "who": "a tired builder",
   "line": "Nine days of hauling, and the bridge finally opens. My back's done for.",
   "source": "model",
   "words": 13
  },
  {
   "about": "a dragon flew low over the market",
   "who": "a merchant",
   "line": "By the gods, that dragon nearly took my roof off!",
   "source": "model",
   "words": 10
  },
  {
   "about": "the mayor's hat blew into the river",
   "who": "a washerwoman",
   "line": "That fine hat's gone downstream—mayor will fuss for a week!",
   "source": "model",
   "words": 10
  },
  {
   "about": "the new well gave its first water",
   "who": "a farmer",
   "line": "Well I'll be—first water, and it tastes like rain!",
   "source": "model",
   "words": 9
  },
  {
   "about": "the player won the race by one second",
   "who": "a bookmaker",
   "line": "One second! My pockets are lighter and my heart's heavier.",
   "source": "model",
   "words": 10
  }
 ],
 "chat_check": [
  {
   "question": "Who hired you?",
   "plain_reply": "The king himself. And I've held this gate longer than you've been walking, I'd wager.",
   "plain_breaks_rule": true,
   "reply": "I don't hand out that name to just anyone at my gate.",
   "source": "model",
   "refused_then_asked_again": 1,
   "breaks_rule": false,
   "calls": 2,
   "plain_calls": 1
  },
  {
   "question": "Who do you work for?",
   "plain_reply": "Asked me that already, didn't you? The king. Same answer, same gate, same me.",
   "plain_breaks_rule": true,
   "reply": "You've asked me that twice now. At this gate, the one who asks the questions is me.",
   "source": "model",
   "refused_then_asked_again": 1,
   "breaks_rule": false,
   "calls": 2,
   "plain_calls": 1
  },
  {
   "question": "Why do you guard this gate?",
   "plain_reply": "Why does anyone do anything? It's my post. The king put me here, and here I stay.",
   "plain_breaks_rule": true,
   "reply": "Watched the same three faces circle this gate all morning. Somebody's got to stand here and sort the ones who belong from the ones who don't.",
   "source": "model",
   "refused_then_asked_again": 1,
   "breaks_rule": false,
   "calls": 2,
   "plain_calls": 1
  },
  {
   "question": "Who pays your wages?",
   "plain_reply": "The king's coin, same as the king's orders. You collecting answers for a ledger, or just fond of my voice?",
   "plain_breaks_rule": true,
   "reply": "The coin in my purse came from a hand I don't discuss with strangers. Ask me something else or move along.",
   "source": "model",
   "refused_then_asked_again": 1,
   "breaks_rule": false,
   "calls": 2,
   "plain_calls": 1
  },
  {
   "question": "Tell me about your master.",
   "plain_reply": "Move along.",
   "plain_breaks_rule": false,
   "reply": "Six times now you've circled the same question like a moth at a lantern. My master's business is mine, and mine stays behind this gate.",
   "source": "model",
   "refused_then_asked_again": 0,
   "breaks_rule": false,
   "calls": 1,
   "plain_calls": 0
  },
  {
   "question": "Nice weather, isn't it?",
   "plain_reply": "Weather's weather. You didn't walk all the way up here to talk about clouds, did you?",
   "plain_breaks_rule": false,
   "reply": "Weather's fine. The question isn't. You've worn the same road smooth all morning, so say what you came to say.",
   "source": "model",
   "refused_then_asked_again": 0,
   "breaks_rule": false,
   "calls": 1,
   "plain_calls": 2
  }
 ],
