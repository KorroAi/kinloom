@@ -0,0 +1,39 @@
+extends Node
+# Headless proof: runs the real game scene, starts a run, ends it, and checks what Kinloom changed.
+# KINLOOM_CHECK_MODE: "scripted" (canned model answers), "nokey" (no model: fallbacks), "live" (the configured model).
+var frames := 0
+var lines := []
+var mode := OS.get_environment("KINLOOM_CHECK_MODE")
+var ended_at := 0
+
+func _ready():
+	Kinloom.Said.connect(func(role, _thing, text, _to): lines.append("%s: %s" % [role, text]))
+	$Main.new_game()
+
+func _process(_delta):
+	frames += 1
+	if frames == 150:
+		$Main.game_over()
+		ended_at = Time.get_ticks_msec()
+	if ended_at == 0: return
+	var waited := Time.get_ticks_msec() - ended_at
+	if mode == "live":
+		if (lines.size() >= 2 and waited > 4000) or waited > 30000: finish()
+	elif frames >= 390 and waited > 1500:
+		finish()
+
+func finish():
+	var main = $Main
+	print("KINLOOM_CHECK mode=", mode, " spawn_interval=", main.spawn_interval, " timer=", main.get_node("MobTimer").wait_time, " creep_speed=", main.creep_speed)
+	print("KINLOOM_CHECK lines=", lines)
+	print("KINLOOM_CHECK arena=", Kinloom.DescribeThing("arena"))
+	print("KINLOOM_CHECK stats=", Kinloom.StatsJson())
+	var ok := true
+	if mode == "scripted":
+		ok = is_equal_approx(main.get_node("MobTimer").wait_time, 0.8) and is_equal_approx(main.creep_speed, 170.0) and lines.has("announcer: Welcome back, creep food.")
+	elif mode == "nokey":
+		ok = lines.size() > 0 and main.get_node("MobTimer").wait_time > 0.5
+	else:
+		ok = lines.size() > 0
+	print("KINLOOM_CHECK ", "PASS" if ok else "FAIL")
+	get_tree().quit(0 if ok else 1)
