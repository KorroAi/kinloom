+extends Node
+# Headless proof inside the real game: makes the player look stuck, destroys a robot, and checks what Kinloom changed.
+# KINLOOM_CHECK_MODE: "scripted" (canned answers), "nokey" (fallbacks only), "live" (the configured model).
+var mode := OS.get_environment("KINLOOM_CHECK_MODE")
+var frames := 0
+var started := 0
+var coins_before := 0
+
+func game() -> Node: return get_parent()
+
+func _process(_delta):
+	frames += 1
+	if frames == 30:
+		coins_before = count_coins()
+		game().get_node("Level/Player").seconds_since_coin = 30.0
+		game().get_node("Level/Enemies/Enemy2").destroy()
+		started = Time.get_ticks_msec()
+	if started == 0: return
+	var waited := Time.get_ticks_msec() - started
+	var hint: Label = game().get_node_or_null("InterfaceLayer/CoachHint")
+	var hinted := hint != null and hint.visible and hint.text != ""
+	if mode == "live":
+		if (hinted and waited > 6000) or waited > 40000: finish()
+	elif frames > 300 and waited > 2000:
+		finish()
+
+func count_coins() -> int:
+	var n := 0
+	for node in game().get_node("Level/Coins").find_children("*", "Coin", true, false): n += 1
+	return n
+
+func finish():
+	var speeds := {}
+	for enemy in game().get_node("Level/Enemies").get_children(): speeds[String(enemy.name)] = enemy.walk_speed
+	var hint: Label = game().get_node_or_null("InterfaceLayer/CoachHint")
+	var hint_text: String = hint.text if hint != null else ""
+	var coins_added := count_coins() - coins_before
+	print("KINLOOM_CHECK mode=", mode, " speeds=", speeds, " coins_added=", coins_added, " hint='", hint_text, "'")
+	print("KINLOOM_CHECK stats=", Kinloom.StatsJson())
+	if mode == "live":
+		for line in Kinloom.JournalText(80).split("\n"):
+			if line.contains(" refused ") or line.contains(" thought ") or line.contains("repairing"): print("KINLOOM_CHECK journal ", line)
+	var ok := false
+	if mode == "scripted":
+		ok = is_equal_approx(speeds.get("Enemy3", 0.0), 60.0) and coins_added == 1 and hint_text == "Try the ledge above the start."
+	elif mode == "nokey":
+		ok = hint_text.contains("double jump")
+	else:
+		ok = hint_text != "" or speeds.values().any(func(s): return not is_equal_approx(s, 22.0))
+	print("KINLOOM_CHECK ", "PASS" if ok else "FAIL")
+	get_tree().quit(0 if ok else 1)
