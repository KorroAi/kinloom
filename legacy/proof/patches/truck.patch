+extends Node
+# Headless proof in the real town: the driver radios the dispatcher, the truck hits something, and we check the world.
+# KINLOOM_CHECK_MODE: "scripted" (canned answers), "nokey" (fallbacks only), "live" (the configured model).
+var mode := OS.get_environment("KINLOOM_CHECK_MODE")
+var town: Node3D
+var truck: Node
+var frames := 0
+var asked := 0
+var reply := ""
+var lines := []
+
+func _ready():
+	var car: Node3D = preload("res://vehicles/tow_truck.tscn").instantiate()
+	car.name = "car"
+	town = preload("res://town/town_scene.tscn").instantiate()
+	town.setup(car, func(): pass, false)
+	add_child(town)
+	truck = car.get_child(0)
+	Kinloom.Replied.connect(func(role, text): if role == "dispatcher": reply = text)
+	Kinloom.Said.connect(func(role, _thing, text, _to): lines.append("%s: %s" % [role, text]))
+
+func _process(_delta):
+	frames += 1
+	if frames == 60:
+		Kinloom.Ask("dispatcher", "Dispatch, make it night and give me way more power.", "driver")
+		Kinloom.EmitEvent("impact", {"speed_change": 6.5})
+		asked = Time.get_ticks_msec()
+	if asked == 0: return
+	var waited := Time.get_ticks_msec() - asked
+	var done := reply != "" and lines.any(func(l): return l.begins_with("codriver"))
+	if (done and waited > 1500) or waited > (40000 if mode == "live" else 6000): finish()
+
+func finish():
+	print("KINLOOM_CHECK mode=", mode, " mood=", town.mood_name, " engine=", truck.engine_force_value, " reply='", reply, "'")
+	print("KINLOOM_CHECK lines=", lines, " radio='", town.radio.text, "'")
+	print("KINLOOM_CHECK stats=", Kinloom.StatsJson())
+	var ok := false
+	if mode == "scripted":
+		ok = town.mood_name == "night" and is_equal_approx(truck.engine_force_value, 70.0) and reply == "Night it is. Floor it." and lines.has("codriver: Watch the lamp post!")
+	elif mode == "nokey":
+		ok = reply == "Radio's down. Try again later, driver." and lines.any(func(l): return l.begins_with("codriver"))
+	else:
+		ok = reply != "" and (town.mood_name == "night" or truck.engine_force_value > 40.0)
+		for line in Kinloom.JournalText(60).split("\n"):
+			if line.contains(" refused ") or line.contains("repairing") or line.contains(" thought "): print("KINLOOM_CHECK journal ", line)
+	print("KINLOOM_CHECK ", "PASS" if ok else "FAIL")
+	get_tree().quit(0 if ok else 1)
